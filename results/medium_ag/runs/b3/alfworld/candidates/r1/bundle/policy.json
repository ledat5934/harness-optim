{
  "bundle_version": 2,
  "config": {
    "D1": {
      "examples": false,
      "structured_instruction": true,
      "compression": "none",
      "strategy": "structured task decomposition and category-based search heuristics"
    },
    "D2": {
      "tool_access": "benchmark_tools",
      "tool_protocol": "native",
      "retrieval_mode": "none",
      "top_k": 0,
      "strategy": "interactive textworld action selection"
    },
    "D3": {
      "temperature": 0.0,
      "max_tokens": 2048,
      "top_p": 1.0,
      "candidate_count": 1,
      "strategy": "deterministic greedy action selection"
    },
    "D4": {
      "workflow": "react_loop",
      "stop_rule": "env_done_or_accepted_finish_or_max_steps",
      "strategy": "stage-based execution: locate -> take -> transform -> place"
    },
    "D5": {
      "memory_policy": "sliding_window",
      "history_keep": 45,
      "strategy": "extended history window (45 turns) to retain exploration map and prevent search cycles"
    },
    "D6": {
      "postprocess": "none",
      "validator": "verifier_slot",
      "fallback": "none",
      "strategy": "action admissibility verification"
    }
  },
  "runtime_files": {
    "agents": "AGENTS.override.md",
    "policy": "policy.json",
    "memory": ".memoharness/memory.md",
    "playbook": ".memoharness/playbook.md"
  },
  "codex": {
    "model": "",
    "reasoning_effort": "medium",
    "reasoning_summary": "auto"
  },
  "updated_iteration": 1
}
